FROM python:3.11-alpine

# upgrade pip
RUN pip install --upgrade pip

# install gcc, python3-dev, musl-dev, and linux-headers for uwsgi
RUN apk add gcc python3-dev musl-dev linux-headers

# get curl for healthchecks
RUN apk add curl

# permissions and nonroot user for tightened security
RUN adduser -D nonroot
RUN mkdir /home/app/ && chown -R nonroot:nonroot /home/app
RUN mkdir -p /var/log/flask-app && touch /var/log/flask-app/flask-app.err.log && touch /var/log/flask-app/flask-app.out.log
RUN chown -R nonroot:nonroot /var/log/flask-app
WORKDIR /home/app
USER nonroot

# venv
ENV VIRTUAL_ENV=/home/app/venv

# python setup (install dependencies first for better caching)
RUN python -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Copy requirements first for better Docker layer caching
COPY --chown=nonroot:nonroot requirements.txt .
RUN pip install -r requirements.txt

# Copy the rest of the files
COPY --chown=nonroot:nonroot . .

RUN export FLASK_APP=app.py

# Use Flask development server with auto-reload
CMD ["python", "-m", "flask", "run", "--host=0.0.0.0", "--port=8001", "--debug"]
