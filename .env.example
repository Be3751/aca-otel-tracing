# OpenTelemetry and Azure Monitor Configuration
# Copy this file to .env and fill in your actual values

# Application Insights connection string (required for tracing)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-app-insights-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/;LiveEndpoint=https://your-region.livediagnostics.monitor.azure.com/

# Azure Storage Account (required for receipt service)
STORAGE_ACCOUNT_NAME=your_storage_account_name
STORAGE_ACCOUNT_CONTAINER_NAME=your_container_name

# Service names (optional - defaults are set)
# OTEL_SERVICE_NAME will be overridden per service in docker-compose.yml
